+std::u16string Utf8ToUtf16(const std::string& utf8) {
+  std::wstring_convert<std::codecvt_utf8_utf16<char16_t>, char16_t> converter;
+  return converter.from_bytes(utf8);
+}
+
+// Moves the cursor one line up or down, holding the column where the target
+// line is long enough. Returns false when there is no line to move to, which
+// is every keypress in a single-line field, leaving the model untouched.
+//
+// TextInputModel has no line-aware movement of its own, and its two offset
+// units disagree: GetCursorOffset() counts UTF-8 bytes while SetSelection()
+// indexes UTF-16 code units. Everything here is therefore done in UTF-16,
+// with the cursor converted up front. Newline is ASCII, so the line splitting
+// itself is safe in either encoding.
+bool MoveCursorByLine(TextInputModel* model, bool up) {
+  const std::string text8 = model->GetText();
+  const std::u16string text = Utf8ToUtf16(text8);
+  const size_t cursor =
+      Utf8ToUtf16(text8.substr(0, model->GetCursorOffset())).size();
+
+  // Start of the line the cursor is on.
+  size_t line_start = 0;
+  if (cursor > 0) {
+    const size_t nl = text.rfind(u'\n', cursor - 1);
+    line_start = (nl == std::u16string::npos) ? 0 : nl + 1;
+  }
+  const size_t column = cursor - line_start;
+
+  size_t target_start;
+  size_t target_length;
+
+  if (up) {
+    if (line_start == 0) {
+      return false;
+    }
+    // text[line_start - 1] is the newline ending the previous line.
+    const size_t nl = (line_start >= 2)
+                          ? text.rfind(u'\n', line_start - 2)
+                          : std::u16string::npos;
+    target_start = (nl == std::u16string::npos) ? 0 : nl + 1;
+    target_length = (line_start - 1) - target_start;
+  } else {
+    const size_t line_end = text.find(u'\n', line_start);
+    if (line_end == std::u16string::npos) {
+      return false;
+    }
+    target_start = line_end + 1;
+    const size_t next_end = text.find(u'\n', target_start);
+    target_length =
+        (next_end == std::u16string::npos ? text.size() : next_end) -
+        target_start;
+  }
+
+  return model->SetSelection(
+      TextRange(target_start + std::min(column, target_length)));
+}
